#! /bin/sh
#
# SETUP
# =====
#    BMU_DIRRSYNC: Backup dirextory for current rsync data
#  BMU_DIRBACKUPS: BAckup directory for rsync, old updated/removed files
#    BMU_OPTRSYNC: rsync Options
# BMU_CMDUPDATEDB: the updatedb command for indexing the files
#   BMU_CMDLOCATE: the locate command for searching files in the index
#
# FAQ
# ===
# Why not JSON or other formats for setup?
# - We are still at beta, and we require maximum but simple compatibility, more over
#   we are not yet sure what are all the machine/OS/FS dependencies,
#   this file at present contains also these dependencies as automated as possible
#   they will be removed when we have a configure and install program.
#   Also the date format is implicit here
#
# LOCAL/USER DEFINED OPTIONS
# --------------------------
#
BMU_DIRRSYNC="${HOME}/Backups/rsyncBackup"
BMU_DIRBACKUPS="${BMU_DIRRSYNC}-BP"
BMU_DIRDBLOCATE="${BMU_DIRRSYNC}/.locate.dir"
#
# OS Options
# ----------
#BMU_INSTDIR="/usr/local/bmu"
BMU_INSTDIR="${HOME}/usr/bmu"
#
# System Options
# --------------
BMU_OPTRSYNC="-av --delete --backup" # --modify-window=1
#
# rsync detection
# ---------------
# Apple ships "openrsync" as /usr/bin/rsync (macOS >= 15). openrsync
# silently ignores --delete when --backup is active, so deleted files
# would stay in the sync dir forever and never reach the backup dir.
# Pick the first real rsync we can find; stays empty if none is usable.
BMU_CMDRSYNC=""
for l_bmu_rsync in rsync /opt/homebrew/bin/rsync /usr/local/bin/rsync /usr/bin/rsync; do
    command -v "${l_bmu_rsync}" > /dev/null 2>&1 || continue
    if "${l_bmu_rsync}" --version 2>/dev/null | head -1 | grep -qi openrsync; then
        continue
    fi
    BMU_CMDRSYNC="${l_bmu_rsync}"
    break
done
#
# Index command detection (capability based, not uname based)
# -----------------------------------------------------------
# Solves the old "gnu or m?" issue: the updatedb dialects differ, while
# "locate -i -d <db> <pattern>" works the same in all of them.
#   GNU findutils:   updatedb --output=FILE --localpaths='DIR'
#                    (on macOS via Homebrew findutils: gupdatedb/glocate)
#   mlocate/plocate: updatedb -l 0 --output=FILE -U DIR
# Stays empty if no updatedb is found; scripts warn/fail accordingly.
BMU_CMDUPDATEDB=''
BMU_UPDBOPT=''
BMU_CMDLOCATE=''
if command -v gupdatedb > /dev/null 2>&1; then
    BMU_CMDUPDATEDB='gupdatedb'
    BMU_UPDBOPT='--localpaths='
    BMU_CMDLOCATE='glocate'
elif command -v updatedb > /dev/null 2>&1; then
    if updatedb --version 2>/dev/null | head -1 | grep -q 'GNU findutils'; then
        BMU_CMDUPDATEDB='updatedb'
        BMU_UPDBOPT='--localpaths='
    else
        BMU_CMDUPDATEDB='updatedb -l 0'
        BMU_UPDBOPT='-U '
    fi
    BMU_CMDLOCATE='locate'
fi;
#
# Off-site replication (optional)
# --------------------------------
# BMU_CMDREPLICATE: the sync tool + base flags, e.g. "rclone sync".
#                    Empty means replication is not configured;
#                    backmeup.replicate.sh refuses to run.
# BMU_REPLICATE_REMOTE_SYNC/_BACKUPS: destination for each tree, e.g.
#                    "remote:bucket/path". Set by backmeup.configure.sh.
BMU_CMDREPLICATE=""
BMU_REPLICATE_REMOTE_SYNC=""
BMU_REPLICATE_REMOTE_BACKUPS=""

