#! /bin/sh
#
# SETUP
# =====
#    BMU_DIRRSYNC: Backup dirextory for current rsync data
#  BMU_DIRBACKUPS: BAckup directory for rsync, old updated/removed files
#    BMU_OPTRSYNC: rsync Options
# BMU_CMDUPDATEDB: the updatedb command for indexing the files
#   BMU_CMDLOCATE: the locate command for searching files in the index
#
# FAQ
# ===
# Why not JSON or other formats for setup?
# - We are still at beta, and we require maximum but simple compatibility, more over
#   we are not yet sure what are all the machine/OS/FS dependencies,
#   this file at present contains also these dependencies as automated as possible
#   they will be removed when we have a configure and install program.
#   Also the date format is implicit here
#
# LOCAL/USER DEFINED OPTIONS
# --------------------------
#
BMU_DIRRSYNC="${HOME}/Backups/rsyncBackup"
BMU_DIRBACKUPS="${BMU_DIRRSYNC}-BP"
BMU_DIRDBLOCATE="${BMU_DIRRSYNC}/.locate.dir"
#
# OS Options
# ----------
#BMU_INSTDIR="/usr/local/bmu"
BMU_INSTDIR="${HOME}/usr/bmu"
#
# System Options
# --------------
BMU_OPTRSYNC="-av --delete --backup" # --modify-window=1
#
# rsync detection
# ---------------
# Kept inline here rather than calling backmeup.shellfunctions.sh's
# bmuDetectRsync (which backmeup.configure.sh uses) - unlike configure.sh,
# this template must stay sourceable completely standalone, with no
# assumption that shellfunctions.sh was sourced first. In particular,
# tests/test_backmeup.sh builds its fake "resolved" setup.sh fixtures by
# sed-substituting this template directly and sourcing the result on its
# own. If you change this detection logic, change bmuDetectRsync too.
#
# Apple ships "openrsync" as /usr/bin/rsync (macOS >= 15). openrsync
# silently ignores --delete when --backup is active, so deleted files
# would stay in the sync dir forever and never reach the backup dir.
# Pick the first real rsync we can find, resolved to its absolute path
# via "command -v" even for a bare-name match - this file only runs
# once, at configure time, so whatever gets baked into BMU_CMDRSYNC
# here is what every future backup run executes verbatim, regardless
# of what PATH looks like then. Baking in a bare name instead of its
# resolved path is a real bug: a cron job's minimal PATH would resolve
# bare "rsync" to openrsync above instead of the Homebrew rsync found
# here, silently reintroducing the exact --delete problem this
# detection exists to avoid - confirmed for real on this machine (see
# bmuDetectRsync's comment in backmeup.shellfunctions.sh for the full
# repro). Stays empty if no real rsync is usable.
BMU_CMDRSYNC=""
for l_bmu_rsync in rsync /opt/homebrew/bin/rsync /usr/local/bin/rsync /usr/bin/rsync; do
    l_bmu_resolved="$(command -v "${l_bmu_rsync}" 2>/dev/null)" || continue
    if "${l_bmu_resolved}" --version 2>/dev/null | head -1 | grep -qi openrsync; then
        continue
    fi
    BMU_CMDRSYNC="${l_bmu_resolved}"
    break
done
#
# Index command detection (capability based, not uname based)
# -----------------------------------------------------------
# Same standalone-sourceable reasoning as above - kept inline, mirrors
# backmeup.shellfunctions.sh's bmuDetectIndexer. Solves the old "gnu or
# bsd?" issue: the updatedb dialects differ, while "locate -i -d <db>
# <pattern>" works the same in all of them.
#   GNU findutils:   updatedb --output=FILE --localpaths='DIR'
#                    (on macOS via Homebrew findutils: gupdatedb/glocate)
#   mlocate/plocate: updatedb -l 0 --output=FILE -U DIR
# Same absolute-path resolution and fallback search as the rsync
# detection above (bare name resolved via "command -v", then
# /opt/homebrew/bin, /usr/local/bin, /usr/bin), for the same
# bake-in-what-configure-time-verified reasoning. Stays empty if no
# updatedb is found anywhere; scripts warn/fail accordingly.
BMU_CMDUPDATEDB=''
BMU_UPDBOPT=''
BMU_CMDLOCATE=''
for l_bmu_dir in '' /opt/homebrew/bin/ /usr/local/bin/ /usr/bin/; do
    l_bmu_gupdatedb="$(command -v "${l_bmu_dir}gupdatedb" 2>/dev/null)"
    l_bmu_updatedb="$(command -v "${l_bmu_dir}updatedb" 2>/dev/null)"
    if [ -n "${l_bmu_gupdatedb}" ]; then
        BMU_CMDUPDATEDB="${l_bmu_gupdatedb}"
        BMU_UPDBOPT='--localpaths='
        BMU_CMDLOCATE="$(command -v "${l_bmu_dir}glocate" 2>/dev/null)"
        break
    elif [ -n "${l_bmu_updatedb}" ]; then
        if "${l_bmu_updatedb}" --version 2>/dev/null | head -1 | grep -q 'GNU findutils'; then
            BMU_CMDUPDATEDB="${l_bmu_updatedb}"
            BMU_UPDBOPT='--localpaths='
        else
            BMU_CMDUPDATEDB="${l_bmu_updatedb} -l 0"
            BMU_UPDBOPT='-U '
        fi
        BMU_CMDLOCATE="$(command -v "${l_bmu_dir}locate" 2>/dev/null)"
        break
    fi
done
#
# Off-site replication (optional)
# --------------------------------
# BMU_CMDREPLICATE: the sync tool + base flags, e.g. "rclone sync".
#                    Empty means replication is not configured;
#                    backmeup.replicate.sh refuses to run.
# BMU_REPLICATE_REMOTE_SYNC/_BACKUPS: destination for each tree, e.g.
#                    "remote:bucket/path". Set by backmeup.configure.sh.
BMU_CMDREPLICATE=""
BMU_REPLICATE_REMOTE_SYNC=""
BMU_REPLICATE_REMOTE_BACKUPS=""

